start":689,"end":690,"title":"PART THREE: THE TRAINING OF THOUGHT","kind":"section","parent":"part-b000689","native_selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(18)","preamble_only":true},{"heading":"b000690","start":690,"end":731,"title":"CHAPTER TWELVE","kind":"chapter","parent":"part-b000689","native_selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(19)","preamble_only":false},{"heading":"b000731","start":731,"end":796,"title":"CHAPTER THIRTEEN","kind":"chapter","parent":"part-b000689","native_selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(20)","preamble_only":false},{"heading":"b000796","start":796,"end":841,"title":"CHAPTER FOURTEEN","kind":"chapter","parent":"part-b000689","native_selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(21)","preamble_only":false},{"heading":"b000841","start":841,"end":890,"title":"CHAPTER FIFTEEN","kind":"chapter","parent":"part-b000689","native_selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(22)","preamble_only":false},{"heading":"b000890","start":890,"end":933,"title":"CHAPTER SIXTEEN","kind":"chapter","parent":"part-b000689","native_selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(23)","preamble_only":false}]}],"guards":{"b000083":{"text":"CHAPTER ONE","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(6)"},"b000932":{"text":"A final exemplification of the required balance between near and far is found in the relation that obtains between the narrower field of experience realized in an individual's own contact with persons and things, and the wider experience of the race that may become his through communication. Instruction always runs the risk of swamping the pupil's own vital, though narrow, experience under masses of communicated material. The instructor ceases and the teacher begins at the point where communicated matter stimulates into fuller and more significant life that which has entered by the strait and narrow gate of sense-perception and motor activity. Genuine communication involves contagion; its name should not be taken in vain by terming communication that which produces no community of thought and purpose between the child and the race of which he is the heir.[Pg 225]","selector":"html:nth-of-type(1) > body:nth-of-type(1) > p:nth-of-type(429)"},"b000137":{"text":"CHAPTER TWO","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(7)"},"b000203":{"text":"CHAPTER THREE","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(8)"},"b000257":{"text":"CHAPTER FOUR","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(9)"},"b000300":{"text":"CHAPTER FIVE","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(10)"},"b000352":{"text":"PART TWO: LOGICAL CONSIDERATIONS","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(11)"},"b000353":{"text":"CHAPTER SIX","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(12)"},"b000394":{"text":"CHAPTER SEVEN","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(13)"},"b000479":{"text":"CHAPTER EIGHT","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(14)"},"b000535":{"text":"CHAPTER NINE","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(15)"},"b000607":{"text":"CHAPTER TEN","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(16)"},"b000641":{"text":"CHAPTER ELEVEN","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(17)"},"b000689":{"text":"PART THREE: THE TRAINING OF THOUGHT","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(18)"},"b000690":{"text":"CHAPTER TWELVE","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(19)"},"b000731":{"text":"CHAPTER THIRTEEN","selector":"html:nth-of-type(1) > body:nth-of-type(1) > h2:nth-of-type(20)"},"b000796":{"text":"CHAPT